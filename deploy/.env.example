# Copy to .env on the VPS (deploy/.env) and fill in. Never commit .env.

# Domains: each needs a DNS A record pointing to the VPS IP before starting
ADMIN_DOMAIN=admin.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Ports on 127.0.0.1 only. Checked free on the VPS (3000 and 4000 belong to existing apps).
API_PORT=4100
ADMIN_PORT=3100
CUSTOMER_PORT=3200

# The keygo database on the VPS's PostgreSQL 18 (host install, not Docker)
DATABASE_URL=postgresql://keygo:YOUR_DB_PASSWORD@localhost:5432/keygo?schema=public

# Long random values. Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
