# Copy to .env on the VPS (deploy/.env) and fill in. Never commit .env.

# Domains: each needs a DNS A record pointing to the VPS IP before starting
ADMIN_DOMAIN=admin.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# GPS tracking server: the map website, and the address phones / trackers send locations to
GPS_DOMAIN=gps.example.com
GPS_INGEST_DOMAIN=gps-in.example.com

# Ports on 127.0.0.1 only. Checked free on the VPS (3000, 4000 and 5432 belong to other software).
API_PORT=4100
ADMIN_PORT=3100
CUSTOMER_PORT=3200
DB_PORT=5433

# Password of the `keygo` user in the keygo-db container. Use letters and digits only, so it
# can go into the database URL as it is. Generate one with:  openssl rand -hex 16
DB_PASSWORD=

# Signs sign-in tokens and protects stored Aadhaar numbers. A long random value; keep it stable.
# Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=

# Encrypts identity documents (ID cards, licences, face photos) and Aadhaar numbers. Make it once with
#   openssl rand -base64 48
# and NEVER change or lose it: write it down and keep a copy outside the server (e.g. a password manager).
# Without it, encrypted documents cannot be opened after a restore. To change it later, put the old one in
# DATA_ENCRYPTION_OLD_KEYS (comma separated) and restart: the server moves everything to the new key.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_OLD_KEYS=

# The Traccar account KeyGo uses to read car locations (the first account you create on https://GPS_DOMAIN).
# Leave empty until Traccar is set up.
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
