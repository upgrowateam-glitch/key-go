# Copy to .env on the VPS (deploy/.env) and fill in. Never commit .env.

# Domains: each needs a DNS A record pointing to the VPS IP before starting
ADMIN_DOMAIN=admin.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Ports on 127.0.0.1 only. Checked free on the VPS (3000, 4000 and 5432 belong to other software).
API_PORT=4100
ADMIN_PORT=3100
CUSTOMER_PORT=3200
DB_PORT=5433

# Password of the `keygo` user in the keygo-db container. Use letters and digits only, so it
# can go into the database URL as it is. Generate one with:  openssl rand -hex 16
DB_PASSWORD=

# Long random values. Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
