# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local install managed with pgAdmin). Create the role and database first; see README.md.
DATABASE_URL="postgresql://keygo:keygo@localhost:5432/keygo?schema=public"

# HTTP
PORT=4000
# Comma-separated browser origins allowed to call the API (admin portal, Expo web). Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Sign-in: a long random secret (at least 16 characters). Changing it signs everyone out.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
# How long a sign-in lasts without use; it renews itself daily while in use.
JWT_ACCESS_TTL=7d
# Encrypts Aadhaar numbers at rest. Defaults to JWT_ACCESS_SECRET; never change it once data exists.
DATA_ENCRYPTION_KEY=

# API docs at /docs are always on in development; set true to show them on the live server too.
ENABLE_API_DOCS=false

# Uploaded documents, photos and signatures are written here until object storage is configured
FILE_STORAGE_DIR=./storage

# Payments and messaging (filled in when those phases start)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
