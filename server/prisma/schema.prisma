// KeyGo data model. Money is stored in paise as integers.
//
// Core entities (staff users, customers, vehicles, rates, bookings) have real columns, so the database
// can enforce the rules that matter (unique logins, no double bookings). Each also has a `details` JSON
// column for the extra fields the apps show.
//
// Everything else the admin portal manages (agreements, inspections, drivers, finance, marketing,
// notifications, ...) is stored in `app_records` as JSON, one row per record, grouped by collection.
// Portal configuration (company profile, policies, terms, templates, ...) lives in `app_settings`.
// These can be moved into dedicated tables later without changing the apps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  DRIVER
}


enum VehicleStatus {
  AVAILABLE
  RESERVED
  ON_RENT
  MAINTENANCE
  SOLD
}

enum Transmission {
  AUTO
  MANUAL
}

enum RentalTerm {
  DAILY
  WEEKLY
  MONTHLY
}

enum RentalPurpose {
  PERSONAL
  BUSINESS
  OUTSTATION
  VACATION
}

enum BookingClassification {
  ONLINE
  WALK_IN
  CORPORATE
  REPEAT_CUSTOMER
  REFERRAL
}

enum BookingStatus {
  QUOTED
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  VIP
}

enum VerificationStatus {
  VERIFIED
  PENDING
  NOT_UPLOADED
  REJECTED
}

// ---------------------------------------------------------------- Branches and staff

model Branch {
  id        String    @id @default(cuid())
  name      String
  address   String
  city      String
  createdAt DateTime  @default(now()) @map("created_at")
  users     User[]
  vehicles  Vehicle[]

  @@map("branches")
}

/// Staff and admin accounts for the admin portal.
model User {
  id           String   @id @default(cuid())
  name         String
  /// Optional: a person can be invited and sign in with their WhatsApp number instead.
  email        String?  @unique
  /// WhatsApp number as digits with country code, e.g. 919876543210. Can be used to sign in.
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  branchId     String?   @map("branch_id")
  branch       Branch?   @relation(fields: [branchId], references: [id])
  /// Branch name as chosen in the portal's Settings → Branches list.
  branchName   String?   @map("branch_name")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  /// For Driver accounts: the driver record (app_records "drivers") this login belongs to.
  driverId     String?   @map("driver_id")
  /// Raised to sign the account out everywhere (password change, "sign out of all devices").
  tokenVersion Int       @default(0) @map("token_version")
  /// Wrong passwords in a row; the account pauses sign-in for a while after too many.
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  /// Invitation link (only its SHA-256 hash is kept) for a person who has not set their password yet.
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------- Customers

model Customer {
  id               String             @id @default(cuid())
  firstName        String             @map("first_name")
  lastName         String             @map("last_name")
  dob              DateTime?          @db.Date
  /// Optional for customers added by staff; required when a customer registers in the app.
  phone            String?            @unique
  email            String?            @unique
  /// Set only for customers who registered in the app and can sign in.
  passwordHash     String?            @map("password_hash")
  /// Raised to sign the customer out everywhere (password change, "sign out of all devices").
  tokenVersion     Int                @default(0) @map("token_version")
  failedLogins     Int                @default(0) @map("failed_logins")
  lockedUntil      DateTime?          @map("locked_until")
  address          String?
  city             String?
  /// Encrypted at rest; only the last four digits are ever returned by the API.
  aadhaarNoEnc     String?            @map("aadhaar_no_enc")
  aadhaarLast4     String?            @map("aadhaar_last4")
  dlNumber         String?            @map("dl_number")
  dlState          String?            @map("dl_state")
  dlExpiry         DateTime?          @map("dl_expiry") @db.Date
  careOfName       String?            @map("care_of_name")
  careOfRelation   String?            @map("care_of_relation")
  careOfPhone      String?            @map("care_of_phone")
  /// Referral / commission code shown in the apps.
  customerCode     String?            @unique @map("customer_code")
  idCardStatus     VerificationStatus @default(NOT_UPLOADED) @map("id_card_status")
  faceVerification VerificationStatus @default(NOT_UPLOADED) @map("face_verification")
  loyaltyTier      LoyaltyTier        @default(BRONZE) @map("loyalty_tier")
  loyaltyPoints    Int                @default(0) @map("loyalty_points")
  /// 0.0 – 5.0, maintained by the business rules in later phases.
  trustRating      Decimal            @default(5.0) @map("trust_rating") @db.Decimal(2, 1)
  /// Documents, photo flags and other profile fields shown in the apps.
  details          Json               @default("{}")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  bookings         Booking[]

  @@map("customers")
}

// ---------------------------------------------------------------- Fleet

model Vehicle {
  id                String        @id @default(cuid())
  name              String
  brand             String?
  /// Car type from the editable list in Settings → Master data (e.g. "Hatchback", "SUV").
  type              String
  color             String?
  seats             Int
  transmission      Transmission
  fuel              String
  badge             String?
  status            VehicleStatus @default(AVAILABLE)
  registrationNo    String        @unique @map("registration_no")
  purchaseCostPaise Int?          @map("purchase_cost_paise")
  purchaseDate      DateTime?     @map("purchase_date") @db.Date
  odometerKm        Int           @default(0) @map("odometer_km")
  fuelLevelPercent  Int           @default(100) @map("fuel_level_percent")
  gpsDeviceId       String?       @map("gps_device_id")
  fastagId          String?       @map("fastag_id")
  insuranceProvider String?       @map("insurance_provider")
  insurancePolicyNo String?       @map("insurance_policy_no")
  insuranceExpiry   DateTime?     @map("insurance_expiry") @db.Date
  pucCertificateNo  String?       @map("puc_certificate_no")
  pucExpiry         DateTime?     @map("puc_expiry") @db.Date
  photoUrl          String?       @map("photo_url")
  /// GPS fix, fuel log, loan, sale, photos, documents and other fields shown in the apps.
  details           Json          @default("{}")
  branchId          String?       @map("branch_id")
  branch            Branch?       @relation(fields: [branchId], references: [id])
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  rates             VehicleRate[]
  bookings          Booking[]

  @@index([status])
  @@index([type])
  @@map("vehicles")
}

/// Price list for a vehicle. The row with the latest `valid_from` on or before today is the current one.
model VehicleRate {
  id                String   @id @default(cuid())
  vehicleId         String   @map("vehicle_id")
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyPaise        Int      @map("daily_paise")
  weeklyPaise       Int      @map("weekly_paise")
  monthlyPaise      Int      @map("monthly_paise")
  depositPaise      Int      @map("deposit_paise")
  driverPerDayPaise Int      @map("driver_per_day_paise")
  validFrom         DateTime @default(now()) @map("valid_from") @db.Date
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([vehicleId, validFrom])
  @@map("vehicle_rates")
}

// ---------------------------------------------------------------- Bookings

/// Quotes, reservations and rentals. The migration adds an exclusion constraint so a vehicle can never
/// hold two CONFIRMED/ACTIVE bookings whose [pickup_at, return_at) periods overlap.
model Booking {
  id                 String                @id @default(cuid())
  customerId         String?               @map("customer_id")
  customer           Customer?             @relation(fields: [customerId], references: [id])
  /// Kept for walk-in bookings made before the customer has an account.
  customerName       String                @map("customer_name")
  customerPhone      String                @map("customer_phone")
  vehicleId          String                @map("vehicle_id")
  vehicle            Vehicle               @relation(fields: [vehicleId], references: [id])
  pickupLocation     String                @map("pickup_location")
  pickupAt           DateTime              @map("pickup_at")
  returnAt           DateTime              @map("return_at")
  days               Int
  term               RentalTerm
  purpose            RentalPurpose
  classification     BookingClassification @default(ONLINE)
  baseRatePaise      Int                   @map("base_rate_paise")
  subtotalPaise      Int                   @map("subtotal_paise")
  discountPaise      Int                   @default(0) @map("discount_paise")
  taxPaise           Int                   @map("tax_paise")
  totalPaise         Int                   @map("total_paise")
  depositPaise       Int                   @map("deposit_paise")
  withDriver         Boolean               @default(false) @map("with_driver")
  status             BookingStatus         @default(PENDING)
  paymentStatus      PaymentStatus         @default(UNPAID) @map("payment_status")
  reminderAt         DateTime?             @map("reminder_at")
  reminderSent       Boolean               @default(false) @map("reminder_sent")
  startOdometerKm    Int?                  @map("start_odometer_km")
  endOdometerKm      Int?                  @map("end_odometer_km")
  damageChargesPaise Int?                  @map("damage_charges_paise")
  fuelChargesPaise   Int?                  @map("fuel_charges_paise")
  tollChargesPaise   Int?                  @map("toll_charges_paise")
  fineChargesPaise   Int?                  @map("fine_charges_paise")
  completedAt        DateTime?             @map("completed_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  /// Rental lifecycle links (agreement, inspections, driver), keyless state and display fields.
  details            Json                  @default("{}")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([vehicleId, pickupAt])
  @@index([customerId])
  @@index([status])
  @@map("bookings")
}

// ---------------------------------------------------------------- Admin records, settings and files

/// One record of an admin-managed list (agreements, inspections, drivers, finance entries, ...).
model AppRecord {
  collection String
  id         String
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([collection, id])
  @@index([collection])
  @@map("app_records")
}

/// One configuration document of the admin portal (company profile, policies, terms, templates, ...).
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// An uploaded file (vehicle document, photo, signature). The bytes live under FILE_STORAGE_DIR.
model StoredFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String   @map("mime_type")
  size       Int
  path       String
  uploadedBy String?  @map("uploaded_by")
  /// "identity" files (ID cards, licences, face photos) are encrypted and only opened through the identity routes.
  category   String   @default("general")
  encrypted  Boolean  @default(false)
  /// The file's own key, encrypted with the server key (see common/crypto.ts).
  wrappedKey String?  @map("wrapped_key")
  /// Which server key wrapped it.
  keyId      String?  @map("key_id")
  identityDocuments IdentityDocument[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("stored_files")
}

/// ID cards, licences, photos and other identity papers of customers and drivers (one per position).
model IdentityDocument {
  id           String             @id @default(cuid())
  /// "customer" or "driver"
  ownerType    String             @map("owner_type")
  ownerId      String             @map("owner_id")
  /// photo, selfie, id_front, id_back, dl_front, dl_back, address_proof, police_verification
  kind         String
  status       VerificationStatus @default(PENDING)
  fileId       String             @map("file_id")
  file         StoredFile         @relation(fields: [fileId], references: [id])
  uploadedBy   String?            @map("uploaded_by")
  /// staff, staff-phone, customer-link
  uploadedVia  String             @default("staff") @map("uploaded_via")
  rejectReason String?            @map("reject_reason")
  reviewedBy   String?            @map("reviewed_by")
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([ownerType, ownerId, kind])
  @@index([ownerType, ownerId])
  @@map("identity_documents")
}

/// Append-only record of sensitive actions (the database refuses updates and deletes).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorId     String?  @map("actor_id")
  actorName   String   @map("actor_name")
  actorRole   String?  @map("actor_role")
  action      String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  subjectName String?  @map("subject_name")
  detail      Json     @default("{}")

  @@index([subjectType, subjectId, at])
  @@index([at])
  @@map("audit_log")
}
