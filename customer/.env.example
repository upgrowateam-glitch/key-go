# Copy to .env.local for local development. Never commit .env.local.

# The KeyGo server the app talks to. Leave empty to use the live server (https://keygo-api.upgrowa.cloud).
# On a phone, "localhost" is the phone itself: use your computer's network address, e.g. http://192.168.1.20:4000
# The value is bundled into the app, so restart Expo (or publish a new update) after changing it.
# Never publish an app update (eas update) while this points at a local server.
EXPO_PUBLIC_API_URL=
