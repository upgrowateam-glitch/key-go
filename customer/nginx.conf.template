# Rendered by the nginx image at start: ${CUSTOMER_PORT} is replaced from the environment.
server {
    listen 127.0.0.1:${CUSTOMER_PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Expo exports one HTML file per route; unknown paths fall back to the app shell
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Hashed bundles and assets never change, so browsers may cache them for a long time
    location /_expo/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /assets/ {
        expires 30d;
    }
}
