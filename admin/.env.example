# Copy to .env.local for local development. Never commit .env.local.

# The KeyGo server the portal talks to. Leave empty to use the live server (https://keygo-api.upgrowa.cloud).
# For a server running on this computer: NEXT_PUBLIC_API_URL=http://localhost:4000
# The value is baked in at build time, so rebuild after changing it.
NEXT_PUBLIC_API_URL=
